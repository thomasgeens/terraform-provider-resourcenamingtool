# Brewfile — run `brew bundle` to install all required tools

# Go toolchain
brew "go"

# Terraform — for acceptance tests and provider development
brew "terraform"

# Linting
brew "golangci-lint"

# GitHub CLI
brew "gh"

# Trunk — linting orchestrator (macOS only via cask; on Linux: curl https://get.trunk.io -fsSL | bash)
cask "trunk-io"

# Fuzzy finder — used by git aliases (.gitconfig)
brew "fzf"
